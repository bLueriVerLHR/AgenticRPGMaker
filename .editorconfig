# AgenticRPGMaker editor settings (shared across tools and members).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown: keep trailing spaces meaningful inside tables/lines.
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
