www/
deploy/
server/build-deploy/

# pnpm store relocated into the workspace (sandboxed builds)
.pnpm-store/
.npmrc

# Local tooling downloads (e.g. self-hosted CMake used in sandboxed builds)
.tools/


# Local playtest artifacts (screenshots, debug probes)
.shots/
