{
  "name": "agenticrpgmaker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgenticRPGMaker monorepo: a portable HTML5 RPG engine (core/renderer/runtime), a Web editor (editor), a C++ relay/hosting server (server/), and samples.",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doc:lint": "node scripts/doc-lint.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "eslint": "^9.31.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0"
  }
}
