{
  "name": "@agenticrpg/editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgenticRPGMaker Web editor (Game Maker): React + TypeScript + Vite (ADR-006). P2 builds the real map/event editor; P0 is the app shell placeholder.",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
