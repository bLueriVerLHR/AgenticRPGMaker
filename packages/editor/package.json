{
  "name": "@agenticrpg/editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgenticRPGMaker Web editor (Game Maker): React + TypeScript + Vite (ADR-006). Stores projects in IndexedDB with import/export to a ZIP project package, and embeds the runtime for preview.",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node e2e/run-e2e.mjs",
    "dev": "vite"
  },
  "dependencies": {
    "@agenticrpg/core": "workspace:*",
    "@agenticrpg/runtime": "workspace:*",
    "fflate": "^0.8.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.54.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
