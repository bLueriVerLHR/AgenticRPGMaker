{
  "name": "@agenticrpg/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgenticRPGMaker playable game runtime: boot sequence, game loop, scenes, saves, multiplayer client (ADR-001, ADR-004). Vanilla TypeScript.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:demo": "vite build --config demo/vite.config.ts",
    "test:e2e": "node e2e/run-e2e.mjs",
    "test:quest": "node e2e/quest-e2e.mjs",
    "test:multiplayer": "node e2e/e2e-multiplayer.mjs"
  },
  "dependencies": {
    "@agenticrpg/core": "workspace:*",
    "@agenticrpg/renderer": "workspace:*"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0",
    "playwright": "^1.54.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
