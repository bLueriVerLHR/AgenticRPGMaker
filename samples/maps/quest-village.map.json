  "events": [
    {
      "id": "evt_elder",
      "name": "Elder Rowan",
      "x": 3,
      "y": 4,
      "sprite": "characters/npc_elder",
      "pages": [
        {
          "condition": {
            "variableId": "ferry_choice",
            "op": "eq",
            "value": 0
          },
          "commands": [
            {
              "cmd": "showText",
              "args": [
                "Grudging coin spends the same as glad coin. The village thanks you, courier — even if Pol doesn't."
              ]
            },
            {
              "cmd": "setSwitch",
              "args": ["sw_ch2_done", true]
            }
          ]
        },
        {
          "condition": {
            "variableId": "ferry_choice",
            "op": "eq",
            "value": 1
          },
          "commands": [
            {
              "cmd": "showText",
              "args": [
                "You worked the debt off instead of squeezing it out? Take my thanks — and Pol's ledger may open a door or two in Millbrook one day."
              ]
            },
            {
              "cmd": "setSwitch",
              "args": ["sw_ch2_done", true]
            }
          ]
        },
        {
          "condition": {
            "switchId": "sw_ch2_started",
            "value": true
          },
          "commands": [
            {
              "cmd": "showText",
              "args": ["Any luck with the ferryman? Thirty coin is the village's winter medicine."]
            }
          ]
        },
        {
          "condition": {
            "switchId": "sw_quest_done",
            "value": true
          },
          "commands": [
            {
              "cmd": "showText",
              "args": [
                "One more errand, courier, and a harder one: the ferryman Pol owes the village thirty coin — winter medicine coin. The flood wall is down; the east road is open."
              ]
            },
            {
              "cmd": "setSwitch",
              "args": ["sw_ch2_started", true]
            }
          ]
        },
        {
          "condition": {
            "switchId": "sw_crate_found",
            "value": true
          },
          "commands": [
            {
              "cmd": "showText",
              "args": [
                "The shipment! Sealed and sound — you have my thanks, and the village's coin."
              ]
            },
            {
              "cmd": "setVariable",
              "args": ["gold", "add", 25]
            },
            {
              "cmd": "setSwitch",
              "args": ["sw_quest_done", true]
            }
          ]
        },
        {
          "condition": null,
          "commands": [
            {
              "cmd": "showText",
              "args": [
                "Our autumn shipment never arrived. Its last crate was hauled toward the Whisper Cave. Take the north road — and mind the slimes."
              ]
            },
            {
              "cmd": "setSwitch",
              "args": ["sw_quest_started", true]
            }
          ]
        }
      ]
    },
